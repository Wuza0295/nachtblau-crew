#!/usr/bin/env bash
# silk-install – Smart App Installer für Windows-/Mac-/Android-Wechsler
# Strategie: zuerst Linux-Gegenstück (Flathub), sonst passende Compat-Schicht.
set -euo pipefail

ALIASES="/usr/share/silk/app-aliases.json"
FLATHUB_API="https://flathub.org/api/v2"

usage() {
  cat <<'EOF'
silk-install – Programme wie gewohnt öffnen, Silk findet Linux-Gegenstücke

Usage:
  silk-install <datei|app-name> [--force-compat]
  silk-install --search <query>
  silk-install --setup-gaming

Unterstützte Dateien:
  Windows:  .exe .msi          → Flatpak, sonst Bottles/Wine
  Android:  .apk               → Flatpak, sonst Waydroid
  macOS:    .dmg .pkg .app     → Flatpak-Gegenstück (macOS-Binaries laufen nicht)

Kein Apple-/Microsoft-Store – Quelle ist Flathub (+ Wine/Waydroid als Fallback).
EOF
}

need() { command -v "$1" >/dev/null 2>&1 || { echo "Fehlt: $1" >&2; exit 1; }; }

dialog_yesno() {
  local msg="$1"
  if command -v kdialog >/dev/null 2>&1; then
    kdialog --yesno "$msg" 2>/dev/null
  elif command -v zenity >/dev/null 2>&1; then
    zenity --question --text="$msg" 2>/dev/null
  else
    return 0
  fi
}

dialog_msg() {
  local msg="$1"
  if command -v kdialog >/dev/null 2>&1; then
    kdialog --msgbox "$msg" 2>/dev/null || true
  elif command -v zenity >/dev/null 2>&1; then
    zenity --info --text="$msg" 2>/dev/null || true
  else
    echo "$msg"
  fi
}

search_flathub() {
  local q="$1"
  need curl
  need jq
  curl -fsSL "${FLATHUB_API}/search" \
    -H 'Content-Type: application/json' \
    -d "$(jq -n --arg q "$q" '{query:$q}')" 2>/dev/null \
    | jq -r '
        (.hits // .) as $h
        | (if ($h|type)=="array" then $h else [] end)[:8][]
        | [
            (.app_id // .flatpakAppId // .appId // .id // empty),
            (.name // ""),
            (.summary // .description // "")
          ]
        | @tsv
      ' 2>/dev/null || true
}

alias_lookup() {
  local key="$1"
  [[ -f "$ALIASES" ]] || return 1
  need jq
  # normalisiere Leerzeichen
  key="$(echo "$key" | tr '[:upper:]' '[:lower:]' | sed -E 's/[[:space:]]+/ /g; s/^ +| +$//g')"
  jq -r --arg k "$key" '
    to_entries[]
    | select((.key | ascii_downcase) == $k)
    | .value
  ' "$ALIASES" 2>/dev/null | head -1
}

install_flatpak() {
  local appid="$1"
  echo "→ Flatpak installieren: ${appid}"
  flatpak remote-add --if-not-exists --user flathub https://dl.flathub.org/repo/flathub.flatpakrepo 2>/dev/null || true
  flatpak install -y --user flathub "$appid"
}

setup_gaming() {
  echo "Gaming-Flatpaks einrichten…"
  while IFS= read -r app; do
    [[ -z "$app" || "$app" =~ ^# ]] && continue
    install_flatpak "$app" || echo "Warnung: $app fehlgeschlagen"
  done < <(grep -vE '^\s*(#|$)' /usr/share/silk/recommended-flatpaks.txt)
  echo "Fertig. Steam, Heroic, Discord & Co. ggf. einmal starten."
}

basename_stem() {
  local f="$1"
  local b
  b="$(basename "$f")"
  # .app Bundle: "Firefox.app" → Firefox
  if [[ "${b,,}" == *.app ]]; then
    b="${b:0:-4}"
  else
    b="${b%.*}"
  fi
  echo "$b"
}

guess_query_from_file() {
  local stem path="$1"
  stem="$(basename_stem "$path")"
  # macOS/Windows Installer-Müll entfernen
  echo "$stem" | sed -E \
    -e 's/\.app$//I' \
    -e 's/[-_ ]?(setup|installer|install|x64|x86|win64|windows|portable|dmg|pkg|universal|arm64|intel)$//I' \
    -e 's/[0-9]+(\.[0-9]+){1,3}//g' \
    -e 's/[-_.]+/ /g' \
    -e 's/^ +| +$//g'
}

resolve_linux_app() {
  local query="$1"
  local appid
  appid="$(alias_lookup "$query" || true)"
  if [[ -z "$appid" ]]; then
    # auch ohne Leerzeichen / mit Bindestrich versuchen
    appid="$(alias_lookup "${query// /-}" || true)"
  fi
  if [[ -z "$appid" ]]; then
    appid="$(search_flathub "$query" | head -1 | cut -f1 || true)"
  fi
  if [[ -n "${appid:-}" && "$appid" != "null" ]]; then
    echo "$appid"
    return 0
  fi
  return 1
}

offer_flatpak_or() {
  local query="$1"
  local yes_msg="$2"
  local appid
  appid="$(resolve_linux_app "$query" || true)"
  if [[ -n "${appid:-}" ]]; then
    echo "Gefundenes Linux-Gegenstück: $appid"
    if dialog_yesno "$yes_msg"$'\n\n'"App: ${appid}"; then
      install_flatpak "$appid"
      return 0
    fi
    return 2
  fi
  echo "Kein klares Flatpak-Gegenstück für „${query}“."
  return 1
}

handle_exe() {
  local file="$1"
  local force="${2:-0}"
  local query
  query="$(guess_query_from_file "$file")"
  echo "Windows-Programm erkannt: $file"
  echo "Suche Linux-Gegenstück für: „${query}“"

  if [[ "$force" != "1" ]]; then
    if offer_flatpak_or "$query" \
      "Linux-App gefunden. Stattdessen Flatpak installieren?"$'\n'"Nein = .exe mit Wine/Bottles wie unter Windows starten."; then
      return 0
    fi
  fi
  exec /usr/bin/silk-run-exe "$file"
}

handle_apk() {
  local file="$1"
  local force="${2:-0}"
  local query
  query="$(guess_query_from_file "$file")"
  echo "Android-APK erkannt: $file"
  echo "Suche Linux-Gegenstück für: „${query}“"

  if [[ "$force" != "1" ]]; then
    if offer_flatpak_or "$query" \
      "Linux-App gefunden. Stattdessen Flatpak installieren?"$'\n'"Nein = APK in Waydroid (Android) installieren."; then
      return 0
    fi
  fi
  exec /usr/bin/silk-run-apk "$file"
}

handle_mac() {
  local file="$1"
  local query appid
  query="$(guess_query_from_file "$file")"
  echo "macOS-Paket erkannt: $file"
  echo "Hinweis: Echte Mac-Apps (.app/.dmg) laufen unter Linux nicht."
  echo "Suche ein Linux-Gegenstück für: „${query}“"

  appid="$(resolve_linux_app "$query" || true)"
  if [[ -n "${appid:-}" ]]; then
    echo "Gefunden: $appid"
    if dialog_yesno "Für „${query}“ gibt es die Linux-App „${appid}“.\n\nJetzt installieren?"; then
      install_flatpak "$appid"
      dialog_msg "Installiert. Du kannst die App im Startmenü/Dock wie gewohnt öffnen."
      return 0
    fi
    exit 0
  fi

  dialog_msg "Kein Linux-Gegenstück für „${query}“ gefunden.\n\nTipps:\n• silk-install --search ${query}\n• Web-Version der App nutzen\n• Falls Windows-Build (.exe) existiert: damit erneut versuchen (Wine/Bottles)"
  echo "Kein Gegenstück. Mac-Binaries können nicht ausgeführt werden." >&2
  exit 3
}

handle_name() {
  local name="$1"
  local appid
  appid="$(resolve_linux_app "$name" || true)"
  if [[ -z "$appid" ]]; then
    echo "Flathub-Treffer:"
    search_flathub "$name" | head -10
    appid="$(search_flathub "$name" | head -1 | cut -f1 || true)"
  fi
  if [[ -n "${appid:-}" && "$appid" != "null" ]]; then
    install_flatpak "$appid"
  else
    echo "Kein Flatpak gefunden für: $name" >&2
    exit 2
  fi
}

is_mac_target() {
  local p="$1"
  local low="${p,,}"
  [[ -f "$p" && ( "$low" == *.dmg || "$low" == *.pkg ) ]] && return 0
  [[ -d "$p" && "$low" == *.app ]] && return 0
  [[ -f "$p" && "$low" == *.app ]] && return 0
  return 1
}

main() {
  local force=0
  local arg="${1:-}"

  case "${arg}" in
    ""|-h|--help) usage; exit 0 ;;
    --setup-gaming) setup_gaming; exit 0 ;;
    --search)
      shift
      search_flathub "${1:-}"
      exit 0
      ;;
    --force-compat)
      force=1
      shift
      arg="${1:-}"
      ;;
  esac

  if [[ "${2:-}" == "--force-compat" ]]; then
    force=1
  fi

  if [[ -e "$arg" ]]; then
    case "${arg,,}" in
      *.exe|*.msi) handle_exe "$arg" "$force" ;;
      *.apk) handle_apk "$arg" "$force" ;;
      *.dmg|*.pkg|*.app) handle_mac "$arg" ;;
      *)
        if is_mac_target "$arg"; then
          handle_mac "$arg"
        else
          echo "Unbekannter Dateityp: $arg" >&2
          exit 1
        fi
        ;;
    esac
  else
    handle_name "$arg"
  fi
}

main "$@"
