#!/usr/bin/env bash
# silk-install – Smart App Installer
# Sucht zuerst Flatpak/App-Store-Äquivalente; fällt sonst auf Wine/Waydroid zurück.
set -euo pipefail

ALIASES="/usr/share/silk/app-aliases.json"
FLATHUB_API="https://flathub.org/api/v2"

usage() {
  cat <<'EOF'
silk-install – intelligenter App-Installer für Aurora Silk

Usage:
  silk-install <datei|app-name> [--force-compat]
  silk-install --search <query>
  silk-install --setup-gaming

Strategie:
  1) Bekannte Alias-Map (app-aliases.json)
  2) Flathub-Suche nach gleichem/ähnlichem Namen
  3) .exe → Bottles/Wine, .apk → Waydroid
  4) Ohne Gegenstück: Kompatibilitätsschicht

Kein Apple App Store – Flathub + Fedora/Aurora sind die Quellen.
EOF
}

need() { command -v "$1" >/dev/null 2>&1 || { echo "Fehlt: $1" >&2; exit 1; }; }

search_flathub() {
  local q="$1"
  need curl
  need jq
  # Flathub API v2: POST /api/v2/search
  curl -fsSL "${FLATHUB_API}/search" \
    -H 'Content-Type: application/json' \
    -d "$(jq -n --arg q "$q" '{query:$q}')" 2>/dev/null \
    | jq -r '
        (.hits // .) as $h
        | (if ($h|type)=="array" then $h else [] end)[:8][]
        | [
            (.app_id // .flatpakAppId // .appId // .id // empty),
            (.name // ""),
            (.summary // .description // "")
          ]
        | @tsv
      ' 2>/dev/null || true
}

alias_lookup() {
  local key="$1"
  [[ -f "$ALIASES" ]] || return 1
  need jq
  jq -r --arg k "${key,,}" '
    to_entries[]
    | select((.key | ascii_downcase) == $k)
    | .value
  ' "$ALIASES" 2>/dev/null | head -1
}

install_flatpak() {
  local appid="$1"
  echo "→ Flatpak installieren: ${appid}"
  flatpak remote-add --if-not-exists --user flathub https://dl.flathub.org/repo/flathub.flatpakrepo 2>/dev/null || true
  flatpak install -y --user flathub "$appid"
}

setup_gaming() {
  echo "Gaming-Flatpaks einrichten…"
  while IFS= read -r app; do
    [[ -z "$app" || "$app" =~ ^# ]] && continue
    install_flatpak "$app" || echo "Warnung: $app fehlgeschlagen"
  done < /usr/share/silk/recommended-flatpaks.txt
  echo "Fertig. Steam/Heroic ggf. einmal starten."
}

basename_stem() {
  local f="$1"
  local b
  b="$(basename "$f")"
  echo "${b%.*}"
}

guess_query_from_file() {
  local stem
  stem="$(basename_stem "$1")"
  # Entferne typische Installer-Suffixe
  echo "$stem" | sed -E 's/[-_]?(setup|installer|x64|x86|win64|windows|portable)$//I; s/[0-9]+(\.[0-9]+){1,3}//g; s/[-_.]+/ /g; s/^ +| +$//g'
}

handle_exe() {
  local file="$1"
  local force="${2:-0}"
  local query appid

  query="$(guess_query_from_file "$file")"
  echo "Windows-Installer erkannt: $file"
  echo "Suche Linux-Gegenstück für: „${query}“"

  if [[ "$force" != "1" ]]; then
    appid="$(alias_lookup "$query" || true)"
    if [[ -z "$appid" ]]; then
      # erste Flathub-Treffer-App-ID
      appid="$(search_flathub "$query" | head -1 | cut -f1 || true)"
    fi
    if [[ -n "${appid:-}" && "$appid" != "null" ]]; then
      echo "Gefundenes Gegenstück: $appid"
      if kdialog --yesno "Linux-App „${appid}“ gefunden.\nStattdessen Flatpak installieren?\n\nNein = .exe mit Wine/Bottles starten." 2>/dev/null; then
        install_flatpak "$appid"
        return 0
      fi
    else
      echo "Kein klares Flatpak-Gegenstück – starte Kompatibilitätsschicht."
    fi
  fi

  exec /usr/bin/silk-run-exe "$file"
}

handle_apk() {
  local file="$1"
  local force="${2:-0}"
  local query appid

  query="$(guess_query_from_file "$file")"
  echo "Android-APK erkannt: $file"
  echo "Suche Linux-Gegenstück für: „${query}“"

  if [[ "$force" != "1" ]]; then
    appid="$(alias_lookup "$query" || true)"
    if [[ -z "$appid" ]]; then
      appid="$(search_flathub "$query" | head -1 | cut -f1 || true)"
    fi
    if [[ -n "${appid:-}" && "$appid" != "null" ]]; then
      echo "Gefundenes Gegenstück: $appid"
      if kdialog --yesno "Linux-App „${appid}“ gefunden.\nStattdessen Flatpak installieren?\n\nNein = APK in Waydroid installieren." 2>/dev/null; then
        install_flatpak "$appid"
        return 0
      fi
    fi
  fi

  exec /usr/bin/silk-run-apk "$file"
}

handle_name() {
  local name="$1"
  local appid
  appid="$(alias_lookup "$name" || true)"
  if [[ -z "$appid" ]]; then
    echo "Flathub-Suche:"
    search_flathub "$name" | head -10
    appid="$(search_flathub "$name" | head -1 | cut -f1 || true)"
  fi
  if [[ -n "${appid:-}" && "$appid" != "null" ]]; then
    install_flatpak "$appid"
  else
    echo "Kein Flatpak gefunden für: $name" >&2
    exit 2
  fi
}

main() {
  local force=0
  local arg="${1:-}"

  case "${arg}" in
    ""|-h|--help) usage; exit 0 ;;
    --setup-gaming) setup_gaming; exit 0 ;;
    --search)
      shift
      search_flathub "${1:-}"
      exit 0
      ;;
    --force-compat)
      force=1
      shift
      arg="${1:-}"
      ;;
  esac

  if [[ "${2:-}" == "--force-compat" ]]; then
    force=1
  fi

  if [[ -f "$arg" ]]; then
    case "${arg,,}" in
      *.exe|*.msi) handle_exe "$arg" "$force" ;;
      *.apk) handle_apk "$arg" "$force" ;;
      *) echo "Unbekannter Dateityp: $arg" >&2; exit 1 ;;
    esac
  else
    handle_name "$arg"
  fi
}

main "$@"
