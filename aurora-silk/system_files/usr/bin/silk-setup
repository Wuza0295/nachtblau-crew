#!/usr/bin/env bash
# silk-setup – Erstkonfiguration: Herkunft (Mac/Windows) + Gaming
set -euo pipefail

MARKER="${XDG_CONFIG_HOME:-$HOME/.config}/silk/.setup-done"
mkdir -p "$(dirname "$MARKER")"

if [[ -f "$MARKER" && "${1:-}" != "--force" ]]; then
  exit 0
fi

notify-send "Aurora Silk" "Willkommen – richte Desktop für Wechsler ein…" 2>/dev/null || true

# 1) Optik: Mac vs Windows 11 vs Windows 10
/usr/bin/silk-desktop --ask || /usr/bin/silk-apply-layout mac || true

# Flatpak-Remotes
flatpak remote-add --if-not-exists --user flathub https://dl.flathub.org/repo/flathub.flatpakrepo || true

# 2) Gaming / Compat-Stack
if [[ "${SILK_AUTO_GAMING:-0}" == "1" ]]; then
  /usr/bin/silk-install --setup-gaming || true
elif command -v kdialog >/dev/null; then
  if kdialog --yesno "Gaming-Apps einrichten (wie unter Windows/Mac)?\n\nSteam, Epic/GOG (Heroic), itch.io, Discord, OBS, Minecraft, osu!, RetroArch, Moonlight, GeForce Now, Bottles, …"; then
    /usr/bin/silk-install --setup-gaming || true
  fi
fi

touch "$MARKER"
notify-send "Aurora Silk" "Fertig. .exe/.dmg/.app/.apk öffnen sich über silk-install. Stil ändern: silk-desktop" 2>/dev/null || true
