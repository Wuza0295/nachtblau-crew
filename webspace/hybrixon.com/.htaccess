Options -MultiViews
DirectoryIndex index.php
RewriteEngine On

# Works both as /hybrixon/ on nacht-blau.de and as document root of hybrixon.com
# (no fixed RewriteBase)

# Allow large multi-media POSTs (15× images/videos). 0 = unlimited for this vhost override.
# Without this, Apache returns HTTP 413 "Request Entity Too Large".
<IfModule mod_security.c>
  SecRequestBodyLimit 1073741824
  SecRequestBodyNoFilesLimit 131072
</IfModule>
LimitRequestBody 1073741824

# Basic hardening
<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set X-Frame-Options "SAMEORIGIN"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
  Header set Permissions-Policy "geolocation=(), microphone=(), camera=()"
</IfModule>

# www → apex (when domain is live)
RewriteCond %{HTTP_HOST} ^www\.hybrixon\.com$ [NC]
RewriteRule ^(.*)$ https://hybrixon.com/$1 [R=301,L]

# Android App Links / Digital Asset Links must be publicly readable
RewriteRule ^\.well-known/ - [L]

# Block direct access to data / PHP internals / Composer vendor
RewriteRule ^data/ - [F,L]
RewriteRule ^includes/ - [F,L]
RewriteRule ^vendor/ - [F,L]

# Prefer PHP over leftover static files
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ index.php [L]

<IfModule mod_mime.c>
  AddType application/json .json
</IfModule>
