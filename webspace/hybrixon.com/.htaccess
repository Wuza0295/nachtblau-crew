Options -MultiViews
DirectoryIndex index.php
# ALL-INKL: PHP 8.5 for Hybrixon
AddHandler php85-cgi .php
RewriteEngine On

# Works both as /hybrixon/ on nacht-blau.de and as document root of hybrixon.com
# (no fixed RewriteBase)

# Allow large media POSTs (single staged file up to ~500 MB).
# Without this, Apache returns HTTP 413 "Request Entity Too Large".
<IfModule mod_security.c>
  SecRequestBodyLimit 1073741824
  SecRequestBodyNoFilesLimit 131072
</IfModule>
LimitRequestBody 1073741824

# Basic hardening (+ HSTS when the request is already HTTPS)
<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set X-Frame-Options "SAMEORIGIN"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
  Header set Permissions-Policy "geolocation=(), microphone=(), camera=()"
  Header set Cross-Origin-Opener-Policy "same-origin-allow-popups"
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains" env=HTTPS
</IfModule>

# Long-lived static assets (cache-busted via ?v= from HYBRIXON_ASSET_*).
<IfModule mod_headers.c>
  <FilesMatch "\.(css|js|svg|png|jpe?g|webp|woff2?)$">
    Header set Cache-Control "public, max-age=604800, immutable"
  </FilesMatch>
</IfModule>

# www → apex (when domain is live)
RewriteCond %{HTTP_HOST} ^www\.hybrixon\.com$ [NC]
RewriteRule ^(.*)$ https://hybrixon.com/$1 [R=301,L]

# Android App Links / Digital Asset Links must be publicly readable
RewriteRule ^\.well-known/ - [L]

# Service worker must not be rewritten
RewriteRule ^sw\.js$ - [L]

# Block direct access to data / PHP internals / Composer vendor
RewriteRule ^data/ - [F,L]
RewriteRule ^includes/ - [F,L]
RewriteRule ^vendor/ - [F,L]

# Prefer PHP over leftover static files
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ index.php [L]

<IfModule mod_mime.c>
  AddType application/json .json
  AddType application/javascript js
</IfModule>
