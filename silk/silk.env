# Silk – Bootc-Image-Parameter

IMAGE_NAME=silk

# GitHub-Organisation / Benutzer (anpassen)
REPO_ORGANIZATION="wuza0295"

IMAGE_DESC="Silk – leichtes, gaming-taugliches Custom-Image auf Universal Blue Aurora (AMD/Intel/NVIDIA) und Asahi (Apple Silicon)"
IMAGE_KEYWORDS="bootc,oci,linux,silk,kde,amd,intel,nvidia,gaming,asahi,apple-silicon,mac"

# NVIDIA-Open-Image (Turing/16xx+), CI baut zusätzlich silk-nvidia-open
IMAGE_NAME_NVIDIA="silk-nvidia-open"

# Apple Silicon Mac (M1+) – Basis: Fedora Asahi Remix Atomic Kinoite
IMAGE_NAME_ASAHI="silk-asahi"
ASAHI_BASE_IMAGE="quay.io/fedora-asahi-remix-atomic-desktops/kinoite:43"

IMAGE_LOGO_URL="https://avatars.githubusercontent.com/u/120078124?s=200&v=4"
DEFAULT_TAG="latest"
BIB_IMAGE="quay.io/centos-bootc/bootc-image-builder:latest"
