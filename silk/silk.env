# Silk – Bootc-Image-Parameter

IMAGE_NAME=silk

# GitHub-Organisation / Benutzer (anpassen)
REPO_ORGANIZATION="wuza0295"

IMAGE_DESC="Silk – leichtes, gaming-taugliches Custom-Image (AMD/Intel/NVIDIA) auf Fedora Atomic / KDE Plasma"

# Upstream-Registry (Universal Blue KDE) – nur technisch, nicht als Produktname bewerben
SILK_UPSTREAM_KDE=ghcr.io/ublue-os/aurora:stable
SILK_UPSTREAM_NVIDIA=ghcr.io/ublue-os/aurora-nvidia-open:stable
IMAGE_KEYWORDS="bootc,oci,linux,silk,kde,amd,intel,nvidia,gaming"

# NVIDIA-Open-Image (Turing/16xx+), CI baut zusätzlich silk-nvidia-open
IMAGE_NAME_NVIDIA="silk-nvidia-open"

# NVIDIA proprietär (ältere GPUs GTX 9xx/10xx) – Upstream aurora-nvidia
IMAGE_NAME_NVIDIA_PROP="silk-nvidia"
SILK_UPSTREAM_NVIDIA_PROP=ghcr.io/ublue-os/aurora-nvidia:stable

# Apple Silicon Mac (M1+) – Basis: Fedora Asahi Remix Atomic Kinoite
IMAGE_NAME_ASAHI="silk-asahi"
ASAHI_BASE_IMAGE="quay.io/fedora-asahi-remix-atomic-desktops/kinoite:43"

IMAGE_LOGO_URL="https://avatars.githubusercontent.com/u/120078124?s=200&v=4"
DEFAULT_TAG="latest"
BIB_IMAGE="quay.io/centos-bootc/bootc-image-builder:latest"
