#!/usr/bin/env bash
# silk-apply-wallpaper – Desktop + Sperrbildschirm anwenden
set -euo pipefail

WALL_DIR="/usr/share/silk/wallpapers"
CFG="${XDG_CONFIG_HOME:-$HOME/.config}/silk/wallpaper.conf"
JS="/usr/share/silk/plasma-apply-wallpaper.js"

# User-Auswahl oder Standard
DESKTOP="${SILK_WALLPAPER_DESKTOP:-${WALL_DIR}/silk-desktop.png}"
LOCK="${SILK_WALLPAPER_LOCK:-${WALL_DIR}/silk-lock.png}"
if [[ -f "$CFG" ]]; then
  # shellcheck disable=SC1090
  source "$CFG"
  DESKTOP="${DESKTOP:-${WALL_DIR}/silk-desktop.png}"
  LOCK="${LOCK:-${WALL_DIR}/silk-lock.png}"
fi

[[ -f "$DESKTOP" ]] || DESKTOP="${WALL_DIR}/silk-desktop-01.png"
[[ -f "$LOCK" ]] || LOCK="${WALL_DIR}/silk-lock-01.png"

apply_plasma_wallpaper() {
  [[ -f "$JS" ]] || return 0
  local tmp js
  tmp="$(mktemp)"
  sed "s|file:///usr/share/silk/wallpapers/silk-desktop.png|file://${DESKTOP}|g" "$JS" > "$tmp"
  js="$(cat "$tmp")"
  rm -f "$tmp"
  if command -v qdbus6 >/dev/null 2>&1; then
    qdbus6 org.kde.plasmashell /PlasmaShell org.kde.PlasmaShell.evaluateScript "$js" 2>/dev/null || true
  elif command -v qdbus >/dev/null 2>&1; then
    qdbus org.kde.plasmashell /PlasmaShell org.kde.PlasmaShell.evaluateScript "$js" 2>/dev/null || true
  fi
}

apply_lock_screen() {
  [[ -f "$LOCK" ]] || return 0
  if command -v kwriteconfig6 >/dev/null 2>&1; then
    kwriteconfig6 --file kscreenlockerrc --group Greeter --group Wallpaper --group org.kde.image --group General --key Image "file://${LOCK}"
    kwriteconfig6 --file kscreenlockerrc --group Greeter --group Wallpaper --group org.kde.image --group General --key FillMode 2
    kwriteconfig6 --file kscreenlockerrc --group Greeter --group Theme --key theme silk-lock
  elif command -v kwriteconfig5 >/dev/null 2>&1; then
    kwriteconfig5 --file kscreenlockerrc --group Greeter --group Wallpaper --group org.kde.image --group General --key Image "file://${LOCK}"
  fi
}

for lf in /usr/share/plasma/look-and-feel/org.silk.*; do
  [[ -d "$lf/contents" ]] || continue
  mkdir -p "$lf/contents/images"
  cp -f "$DESKTOP" "$lf/contents/images/wallpaper.png" 2>/dev/null || true
done

apply_plasma_wallpaper
apply_lock_screen
echo "Wallpaper: $(basename "$DESKTOP") · Lock: $(basename "$LOCK")"
