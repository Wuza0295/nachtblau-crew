#!/usr/bin/env bash
# Silk-Produktidentität – schreibt os-release vollständig (kein Aurora sichtbar).
# Build: /usr ist schreibbar. Laufzeit (ostree): nur /etc – dort echte Datei statt Symlink.
set -euo pipefail

OS_RELEASE_CONTENT='NAME="Silk"
PRETTY_NAME="Silk"
ID=silk
ID_LIKE="fedora"
VERSION="1.0 (Silk)"
VERSION_ID="1.0"
VARIANT="Silk"
VARIANT_ID=silk
HOME_URL="https://github.com/Wuza0295/nachtblau-crew"
DOCUMENTATION_URL="https://github.com/Wuza0295/nachtblau-crew/blob/main/silk/QUICKSTART.md"
SUPPORT_URL="https://github.com/Wuza0295/nachtblau-crew/issues"
BUG_REPORT_URL="https://github.com/Wuza0295/nachtblau-crew/issues"
LOGO=silk-logo
ANSI_COLOR="0;38;2;94;177;255"'

write_os_release() {
  local f="$1"
  local dir
  dir="$(dirname "$f")"
  [[ -d "$dir" ]] || return 0

  # Symlink nach /usr (read-only zur Laufzeit) durch echte Datei ersetzen
  if [[ -L "$f" ]]; then
    rm -f "$f" 2>/dev/null || return 0
  fi

  if [[ -w "$dir" ]] || { [[ -e "$f" ]] && [[ -w "$f" ]]; }; then
    printf '%s\n' "$OS_RELEASE_CONTENT" >"$f" 2>/dev/null || true
  fi
}

write_os_release /usr/lib/os-release
write_os_release /etc/os-release

# Upstream product_name in Anaconda-/Image-Configs falls vorhanden
for conf in /etc/osbuild-config /usr/share/anaconda/product.img /etc/anaconda/product.conf; do
  if [[ -f "$conf" ]] && [[ -w "$conf" ]]; then
    sed -i \
      -e 's/^product_name\s*=.*/product_name = Silk/' \
      -e 's/Aurora/Silk/g' \
      -e 's/Fedora Linux/Silk/g' \
      "$conf" 2>/dev/null || true
  fi
done

if [[ -f /usr/share/ublue-os/image-info.json ]] && command -v python3 >/dev/null 2>&1; then
  python3 - <<'PY' || true
import json, pathlib, re
p = pathlib.Path("/usr/share/ublue-os/image-info.json")
try:
    data = json.loads(p.read_text())
except Exception:
    raise SystemExit(0)

def scrub(obj):
    if isinstance(obj, dict):
        for k, v in list(obj.items()):
            if k in ("image-name", "name"):
                obj[k] = "Silk" if k == "name" else "silk"
            elif k == "image-vendor":
                obj[k] = "wuza0295"
            elif isinstance(v, str) and re.search(r"aurora|universal blue", v, re.I):
                obj[k] = re.sub(r"(?i)aurora|universal blue", "Silk", v)
            else:
                scrub(v)
    elif isinstance(obj, list):
        for i, v in enumerate(obj):
            if isinstance(v, str) and re.search(r"aurora|universal blue", v, re.I):
                obj[i] = re.sub(r"(?i)aurora|universal blue", "Silk", v)
            else:
                scrub(v)

scrub(data)
data["image-name"] = "silk"
data["image-vendor"] = "wuza0295"
data["name"] = "Silk"
p.write_text(json.dumps(data, indent=2) + "\n")
PY
fi
