#!/usr/bin/env bash
# Silk-Produktidentität in os-release / image-info (nach bootc switch erneut ausführen).
set -euo pipefail

brand_os_release() {
  local f="$1"
  [[ -f "$f" ]] || return 0
  sed -i \
    -e 's/^NAME=.*/NAME="Silk"/' \
    -e 's/^PRETTY_NAME=.*/PRETTY_NAME="Silk"/' \
    -e 's/^VARIANT=.*/VARIANT="Silk"/' \
    -e 's/^VARIANT_ID=.*/VARIANT_ID=silk/' \
    -e 's/^VERSION=.*/VERSION="1.0 (Silk)"/' \
    -e 's/^VERSION_ID=.*/VERSION_ID=1.0/' \
    -e 's/^ID_LIKE=.*/ID_LIKE="fedora"/' \
    -e 's|^BUG_REPORT_URL=.*|BUG_REPORT_URL="https://github.com/Wuza0295/nachtblau-crew/issues"|' \
    -e 's|^DOCUMENTATION_URL=.*|DOCUMENTATION_URL="https://github.com/Wuza0295/nachtblau-crew/blob/main/silk/QUICKSTART.md"|' \
    -e 's|^SUPPORT_URL=.*|SUPPORT_URL="https://github.com/Wuza0295/nachtblau-crew/issues"|' \
    -e 's|^HOME_URL=.*|HOME_URL="https://github.com/Wuza0295/nachtblau-crew"|' \
    "$f" 2>/dev/null || true
  # Aurora/Fedora aus verbleibenden Feldern entfernen (VERSION-Zeile etc.)
  sed -i \
    -e 's/Aurora/Silk/g' \
    -e 's/Universal Blue Silk/Silk/g' \
    "$f" 2>/dev/null || true
  grep -q '^HOME_URL=' "$f" || echo 'HOME_URL="https://github.com/Wuza0295/nachtblau-crew"' >> "$f"
  grep -q '^SUPPORT_URL=' "$f" || echo 'SUPPORT_URL="https://github.com/Wuza0295/nachtblau-crew/issues"' >> "$f"
}

brand_os_release /usr/lib/os-release
brand_os_release /etc/os-release

if [[ -f /usr/share/ublue-os/image-info.json ]] && command -v python3 >/dev/null 2>&1; then
  python3 - <<'PY' || true
import json, pathlib, re
p = pathlib.Path("/usr/share/ublue-os/image-info.json")
data = json.loads(p.read_text())

def scrub(obj):
    if isinstance(obj, dict):
        for k, v in list(obj.items()):
            if k in ("image-name", "name"):
                obj[k] = "Silk"
            elif k == "image-vendor":
                obj[k] = "wuza0295"
            elif isinstance(v, str) and re.search(r"aurora", v, re.I):
                obj[k] = re.sub(r"(?i)aurora", "Silk", v)
            else:
                scrub(v)
    elif isinstance(obj, list):
        for i, v in enumerate(obj):
            if isinstance(v, str) and re.search(r"aurora", v, re.I):
                obj[i] = re.sub(r"(?i)aurora", "Silk", v)
            else:
                scrub(v)

scrub(data)
data["image-name"] = "silk"
data["image-vendor"] = "wuza0295"
data["name"] = "Silk"
p.write_text(json.dumps(data, indent=2) + "\n")
PY
fi
