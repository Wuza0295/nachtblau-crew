#!/usr/bin/env bash
# Silk User-Ready – leitet an silk-tour (geführte UX)
set -euo pipefail

MARKER="${XDG_CONFIG_HOME:-$HOME/.config}/silk/.user-ready-done"
TOUR="${XDG_CONFIG_HOME:-$HOME/.config}/silk/.tour-done"
mkdir -p "$(dirname "$MARKER")"

# Tour übernimmt die komplette Erst-UX
if [[ -x /usr/bin/silk-tour ]]; then
  if [[ "${1:-}" == "--force" ]]; then
    exec /usr/bin/silk-tour --force
  fi
  # Noch keine Tour → Tour starten (setzt auch user-ready)
  if [[ ! -f "$TOUR" ]]; then
    exec /usr/bin/silk-tour
  fi
  # Tour schon gelaufen → fertig / Tipps
  [[ -f "$MARKER" ]] || touch "$MARKER"
  exit 0
fi

# Fallback ohne silk-tour
[[ -f "$MARKER" && "${1:-}" != "--force" ]] && exit 0
notify-send "Silk" "Richte dein System ein…" 2>/dev/null || true
flatpak remote-add --if-not-exists --user flathub https://dl.flathub.org/repo/flathub.flatpakrepo 2>/dev/null || true
[[ "${SILK_SKIP_WINDOWS:-0}" != "1" ]] && /usr/bin/silk-windows setup >/tmp/silk-windows-setup.log 2>&1 || true
if [[ ! -f "${XDG_CONFIG_HOME:-$HOME/.config}/silk/.setup-done" ]]; then
  export SILK_SKIP_PLATFORM=1 SILK_AUTO_WINDOWS=0
  /usr/bin/silk-setup --force >/tmp/silk-setup.log 2>&1 || true
fi
/usr/bin/silk-controllers setup >/tmp/silk-controllers.log 2>&1 || true
touch "$MARKER"
notify-send "Silk" "Fertig – auspacken und loslegen." 2>/dev/null || true
exit 0
