[Unit]
Description=Silk product identity (os-release)
Documentation=https://github.com/Wuza0295/nachtblau-crew/blob/main/silk/QUICKSTART.md
DefaultDependencies=no
After=local-fs.target
Before=display-manager.service multi-user.target

[Service]
Type=oneshot
ExecStart=/usr/libexec/silk/brand-os-release
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
