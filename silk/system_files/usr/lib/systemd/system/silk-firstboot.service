[Unit]
Description=Silk firstboot – GPU recognize + auto image switch, controllers ready
After=local-fs.target network-online.target
Wants=network-online.target
ConditionPathExists=!/var/lib/silk/firstboot-done

[Service]
Type=oneshot
ExecStart=/usr/libexec/silk/firstboot
RemainAfterExit=yes
TimeoutStartSec=900

[Install]
WantedBy=multi-user.target
