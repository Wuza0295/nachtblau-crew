# Silk – Controller / Gamepads (USB + Bluetooth)
# Xbox, DualSense/DualShock, Switch Pro, 8BitDo, generische HID
# Ergänzt steam-devices; Regeln sind best-effort und idempotent.

# Zugriff für Eingabe-Gruppe
KERNEL=="hidraw*", ATTRS{idVendor}=="054c", MODE="0660", TAG+="uaccess"
KERNEL=="hidraw*", ATTRS{idVendor}=="057e", MODE="0660", TAG+="uaccess"
KERNEL=="hidraw*", ATTRS{idVendor}=="045e", MODE="0660", TAG+="uaccess"
KERNEL=="hidraw*", ATTRS{idVendor}=="2dc8", MODE="0660", TAG+="uaccess"
KERNEL=="hidraw*", ATTRS{idVendor}=="046d", MODE="0660", TAG+="uaccess"
KERNEL=="hidraw*", ATTRS{idVendor}=="0e6f", MODE="0660", TAG+="uaccess"
KERNEL=="hidraw*", ATTRS{idVendor}=="24c6", MODE="0660", TAG+="uaccess"
KERNEL=="hidraw*", ATTRS{idVendor}=="1532", MODE="0660", TAG+="uaccess"
KERNEL=="hidraw*", ATTRS{idVendor}=="0f0d", MODE="0660", TAG+="uaccess"
KERNEL=="hidraw*", ATTRS{idVendor}=="2563", MODE="0660", TAG+="uaccess"
KERNEL=="hidraw*", ATTRS{idVendor}=="0079", MODE="0660", TAG+="uaccess"

# Joystick-Nodes
KERNEL=="js[0-9]*", MODE="0660", TAG+="uaccess"
KERNEL=="event*", ENV{ID_INPUT_JOYSTICK}=="1", MODE="0660", TAG+="uaccess"

# Sony DualShock 4 / DualSense / DualSense Edge
SUBSYSTEM=="usb", ATTR{idVendor}=="054c", ATTR{idProduct}=="05c4", MODE="0660", TAG+="uaccess"
SUBSYSTEM=="usb", ATTR{idVendor}=="054c", ATTR{idProduct}=="09cc", MODE="0660", TAG+="uaccess"
SUBSYSTEM=="usb", ATTR{idVendor}=="054c", ATTR{idProduct}=="0ce6", MODE="0660", TAG+="uaccess"
SUBSYSTEM=="usb", ATTR{idVendor}=="054c", ATTR{idProduct}=="0df2", MODE="0660", TAG+="uaccess"
SUBSYSTEM=="usb", ATTR{idVendor}=="054c", ATTR{idProduct}=="0e5f", MODE="0660", TAG+="uaccess"

# Nintendo Switch Pro / Joy-Con / SNES
SUBSYSTEM=="usb", ATTR{idVendor}=="057e", MODE="0660", TAG+="uaccess"

# Xbox One / Series / 360 / Elite
SUBSYSTEM=="usb", ATTR{idVendor}=="045e", MODE="0660", TAG+="uaccess"

# 8BitDo
SUBSYSTEM=="usb", ATTR{idVendor}=="2dc8", MODE="0660", TAG+="uaccess"

# Logitech F310/F710/G Gamepads
SUBSYSTEM=="usb", ATTR{idVendor}=="046d", ATTR{idProduct}=="c21d", MODE="0660", TAG+="uaccess"
SUBSYSTEM=="usb", ATTR{idVendor}=="046d", ATTR{idProduct}=="c219", MODE="0660", TAG+="uaccess"
SUBSYSTEM=="usb", ATTR{idVendor}=="046d", ATTR{idProduct}=="c216", MODE="0660", TAG+="uaccess"

# Razer / Thrustmaster / Mad Catz / PowerA / Turtle Beach / SteelSeries
SUBSYSTEM=="usb", ATTR{idVendor}=="1532", MODE="0660", TAG+="uaccess"
SUBSYSTEM=="usb", ATTR{idVendor}=="044f", MODE="0660", TAG+="uaccess"
SUBSYSTEM=="usb", ATTR{idVendor}=="0738", MODE="0660", TAG+="uaccess"
SUBSYSTEM=="usb", ATTR{idVendor}=="20d6", MODE="0660", TAG+="uaccess"
SUBSYSTEM=="usb", ATTR{idVendor}=="10f5", MODE="0660", TAG+="uaccess"
SUBSYSTEM=="usb", ATTR{idVendor}=="1038", MODE="0660", TAG+="uaccess"

# Google Stadia (legacy) / Backbone / Backbone One
SUBSYSTEM=="usb", ATTR{idVendor}=="18d1", MODE="0660", TAG+="uaccess"
SUBSYSTEM=="usb", ATTR{idVendor}=="3285", MODE="0660", TAG+="uaccess"

# Generic HID gamepads
KERNEL=="hidraw*", ATTRS{idVendor}=="*", ENV{ID_INPUT_JOYSTICK}=="1", MODE="0660", TAG+="uaccess"
