{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:best-practices",
  ],

  "rebaseWhen": "never",

  "packageRules": [
    {
      "automerge": true,
      "matchUpdateTypes": ["pin", "pinDigest"],
    },
    {
      "description": "Do not pin digests on GH Actions container refs in workflows",
      "enabled": false,
      "matchUpdateTypes": ["digest", "pinDigest", "pin"],
      "matchDepTypes": ["container"],
      "matchFileNames": [".github/workflows/**.yaml", ".github/workflows/**.yml"],
    },
    {
      // Silk tracks ghcr.io/ublue-os/aurora:stable via daily CI rebuild
      // (--pull=always). Digest-pinning would freeze upstream and defeat rolling updates.
      "description": "Keep Containerfile base on floating :stable (no digest pin)",
      "matchFileNames": ["Containerfile", "**/Containerfile"],
      "matchDatasources": ["docker"],
      "pinDigests": false,
      "enabled": false,
    },
  ],
}
