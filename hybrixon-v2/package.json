{
  "name": "hybrixon-v2",
  "private": true,
  "version": "2.0.0",
  "packageManager": "pnpm@10.4.1",
  "scripts": {
    "dev": "pnpm --parallel --filter @hybrixon/api --filter @hybrixon/web dev",
    "build": "pnpm -r --if-present build",
    "check": "pnpm -r --if-present check",
    "test": "pnpm -r --if-present test",
    "db:generate": "pnpm --filter @hybrixon/api db:generate",
    "db:migrate": "pnpm --filter @hybrixon/api db:migrate",
    "legacy:migrate": "pnpm --filter @hybrixon/api legacy:migrate"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "argon2",
      "esbuild",
      "msgpackr-extract"
    ]
  }
}
