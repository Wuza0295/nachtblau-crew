# Public entrypoints
PUBLIC_WEB_URL=https://next.hybrixon.com
PUBLIC_API_URL=https://api.hybrixon.com/v2
VITE_API_URL=http://localhost:8080/v2
EXPO_PUBLIC_API_URL=http://10.0.2.2:8080/v2

# API
NODE_ENV=development
PORT=8080
DATABASE_URL=postgresql://hybrixon:hybrixon@postgres:5432/hybrixon
REDIS_URL=redis://redis:6379
JWT_SECRET=replace-with-at-least-32-random-characters
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_DAYS=30
CORS_ORIGINS=http://localhost:5173,https://next.hybrixon.com

# S3-compatible storage (MinIO locally; any S3 provider in production)
S3_ENDPOINT=http://minio:9000
S3_REGION=eu-central-1
S3_BUCKET=hybrixon-media
S3_ACCESS_KEY=hybrixon
S3_SECRET_KEY=replace-this-minio-secret
S3_FORCE_PATH_STYLE=true
CDN_BASE_URL=http://localhost:9000/hybrixon-media

# Media worker
MEDIA_TMP_DIR=/tmp/hybrixon-media
MEDIA_HLS_SEGMENT_SECONDS=6
MEDIA_VIDEO_CRF=23
MEDIA_MAX_IMAGE_BYTES=12000000
MEDIA_MAX_VIDEO_BYTES=500000000

# Legacy migration (read-only source; uploads are copied to S3)
LEGACY_SQLITE_PATH=/legacy/data/hybrixon.sqlite
LEGACY_UPLOADS_PATH=/legacy/uploads
