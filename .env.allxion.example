# Build-Profil für Allxion (Webspace / Android PWA / Linux Desktop PWA)
# Kopie: cp .env.allxion.example .env.allxion

VITE_APP_BASE=/allxion/
VITE_APP_TITLE=Allxion · NachtBlau Crew

