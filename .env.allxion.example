# Allxion platform build (Linux · Android PWA · Webspace)
# Kopie nach .env.allxion — nicht committen (.gitignore).

# Optional: Manus-/Backend-URL für Login, Feed und Forum (ohne trailing slash)
# Wenn leer: relative /api/trpc (nur sinnvoll wenn Backend am gleichen Host läuft)
VITE_API_ORIGIN=

# Vite public base for ALL-INKL Unterseite (default im Script: /allxion/)
VITE_APP_BASE=/allxion/
