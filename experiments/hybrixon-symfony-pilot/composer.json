{
  "name": "nachtblau/hybrixon-symfony-pilot",
  "description": "Isolated Symfony 7.4 LTS pilot for evaluating one Hybrixon route",
  "type": "project",
  "require": {
    "php": ">=8.5",
    "symfony/framework-bundle": "7.4.*",
    "symfony/runtime": "7.4.*"
  },
  "autoload": {
    "psr-4": {
      "App\\": "src/"
    }
  },
  "config": {
    "allow-plugins": {
      "symfony/runtime": true
    },
    "platform": {
      "php": "8.5.3"
    },
    "sort-packages": true
  }
}
