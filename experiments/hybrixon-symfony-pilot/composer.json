{
  "name": "nachtblau/hybrixon-symfony-pilot",
  "description": "Isolated Symfony 7.4 LTS pilot for evaluating one Hybrixon route",
  "type": "project",
  "require": {
    "php": ">=8.5",
    "symfony/framework-bundle": "7.4.*",
    "symfony/runtime": "7.4.*",
    "symfony/yaml": "7.4.*",
    "symfony/string": "7.4.*"
  },
  "autoload": {
    "psr-4": {
      "App\\": "src/"
    }
  },
  "config": {
    "allow-plugins": {
      "symfony/runtime": true
    },
    "platform": {
      "php": "8.5.3"
    },
    "sort-packages": true
  },
  "license": "proprietary",
  "conflict": {
    "symfony/cache": ">=8.0",
    "symfony/config": ">=8.0",
    "symfony/dependency-injection": ">=8.0",
    "symfony/error-handler": ">=8.0",
    "symfony/event-dispatcher": ">=8.0",
    "symfony/filesystem": ">=8.0",
    "symfony/finder": ">=8.0",
    "symfony/http-foundation": ">=8.0",
    "symfony/http-kernel": ">=8.0",
    "symfony/routing": ">=8.0",
    "symfony/var-dumper": ">=8.0",
    "symfony/var-exporter": ">=8.0"
  }
}
