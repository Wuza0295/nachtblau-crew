{
  "name": "nachtblau-crew",
  "version": "1.0.0",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "NODE_ENV=development tsx watch server/_core/index.ts",
    "build": "vite build && esbuild server/_core/index.ts --platform=node --packages=external --bundle --format=esm --outdir=dist",
    "start": "NODE_ENV=production node dist/index.js",
    "check": "tsc --noEmit",
    "format": "prettier --write .",
    "test": "vitest run && python3 scripts/test_hub_sync.py && python3 scripts/test_sync_bazzite_windows.py && python3 scripts/test_dualboot_sync_saves.py && python3 scripts/test_autosync_units.py && node --test apps/nachtblau-hub/resolve-hub-url.test.cjs",
    "autosync:install": "bash scripts/autosync/install-autosync-linux.sh --enable",
    "autosync:status": "bash scripts/autosync/install-autosync-linux.sh --status",
    "autosync:run": "bash scripts/autosync/run-autosync.sh",
    "autosync:disable": "bash scripts/autosync/install-autosync-linux.sh --disable",
    "hub:sync": "python3 scripts/hub-sync.py sync",
    "hub:push": "python3 scripts/hub-sync.py push",
    "hub:pull": "python3 scripts/hub-sync.py pull",
    "hub:status": "python3 scripts/hub-sync.py status",
    "hub:check": "python3 scripts/hub-sync.py check",
    "sync:bazzite-windows": "python3 scripts/sync_bazzite_windows.py",
    "db:push": "drizzle-kit generate && drizzle-kit migrate",
    "db:seed": "tsx server/seed.ts",
    "sync:machines": "bash scripts/sync-bazzite-windows.sh",
    "sync:bazzite": "bash scripts/desktop/nacht-install-bazzite.sh",
    "sync:windows": "echo 'Auf Windows in Admin-PowerShell: .\\\\scripts\\\\desktop\\\\run-nachtblau-from-windows.ps1 -Yes (siehe scripts/desktop/README.md)'",
    "desktop:status": "bash scripts/desktop/nacht-status-desktop.sh",
    "sync:saves": "bash scripts/dualboot/sync-saves.sh",
    "deploy:windows-hub": "python3 scripts/sync_bazzite_windows.py",
    "deploy:prepare": "python3 scripts/deploy_prepare.py"
  },
  "dependencies": {
