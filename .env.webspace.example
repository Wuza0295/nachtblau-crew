# ALL-INKL FTPS credentials for webspace sync (DO NOT COMMIT .env.webspace).
# Copy:  cp .env.webspace.example .env.webspace
# Source: ALL-INKL Members Area → Passwörter / FTP-Accounts
#
# Then:
#   set -a && source .env.webspace && set +a
#   python3 scripts/sync-one-webspace.py hybrixon.com --health-check
#   # or CSS/JS only:
#   python3 scripts/deploy-hybrixon-css.py

FTP_HOST=w02176b7.kasserver.com
FTP_USER=
FTP_PASS=
FTP_TLS=1
# Default remote root for legacy sync (omit when passing a domain arg):
FTP_REMOTE_DIR=/nacht-blau.de
