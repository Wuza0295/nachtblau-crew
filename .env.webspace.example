# ALL-INKL Webspace (FTPS) – Kopie nach .env.webspace und Werte eintragen.
# Nicht committen (.gitignore).
# Passwörter: Members Area → Passwörter / FTP-Accounts

FTP_HOST=w02176b7.kasserver.com
FTP_USER=
FTP_PASS=
# Standard für Einzel-Sync (pnpm webspace:sync:one):
FTP_REMOTE_DIR=/nacht-blau.de
FTP_TLS=1

# Autic Treasures – zwei FTP-Accounts (nicht denselben für beide nutzen):
#   1) Hauptdomain autic-treasures.com  → FTP_USER/FTP_PASS vom Haupt-Webspace
#        FTP_REMOTE_DIR=/autic-treasures.com python3 scripts/deploy-webspace.py
#   2) Subdomain autictreasures.nacht-blau.de → KAS-Account der Subdomain (eigener FTP-Login)
#        FTP_USER=… FTP_PASS=… FTP_REMOTE_DIR=/autictreasures.nacht-blau.de python3 scripts/deploy-webspace.py
# GitHub Actions: Secrets FTP_HOST, FTP_USER, FTP_PASS, FTP_USER_SUBDOMAIN, FTP_PASS_SUBDOMAIN

# Alle Domains:
#   pnpm webspace:pull      # Remote → lokal webspace/<domain>/
#   pnpm webspace:sync      # lokal → Remote (alles was lokal liegt)
#   pnpm webspace:sync:one nacht-blau.de

