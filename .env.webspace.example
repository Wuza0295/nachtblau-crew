# ALL-INKL Webspace (FTPS) – Kopie nach .env.webspace und Werte eintragen.
# Nicht committen (.gitignore).
# Passwörter: Members Area → Passwörter / FTP-Accounts

FTP_HOST=w02176b7.kasserver.com
FTP_USER=
FTP_PASS=
# Standard für Einzel-Sync (pnpm webspace:sync:nacht-blau):
FTP_REMOTE_DIR=/nacht-blau.de
FTP_TLS=1

# Öffentliche URL der Allxion-/Crew-App (Manus Deploy o.ä.)
# Wird beim Sync in webspace/nacht-blau.de/data/projects.json eingetragen.
WEBSPACE_ALLXION_URL=https://deine-app-url.example/

# Alle Domains:
#   pnpm webspace:pull              # Remote → lokal webspace/<domain>/
#   pnpm webspace:sync              # lokal → Remote (alles was lokal liegt)
#   pnpm webspace:sync:nacht-blau   # nur nacht-blau.de inkl. Allxion-Link
