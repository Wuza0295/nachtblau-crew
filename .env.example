# Local development environment variables for nachtblau-crew
# Copy to `.env` (git-ignored) and adjust as needed.
#
# See README.md > "Environment Variables" for the full list of system envs.
# Server-side values are read via server/_core/env.ts.

# --- Required for full functionality ---------------------------------------
# MySQL / MariaDB connection string (drizzle-orm + mysql2).
DATABASE_URL=mysql://nachtblau:nachtblau@127.0.0.1:3306/nachtblau

# Secret used to sign session cookies (any non-empty string for local dev).
JWT_SECRET=dev-local-jwt-secret-change-me

# --- Runtime ---------------------------------------------------------------
NODE_ENV=development
# Preferred port; the server auto-selects the next free port if it is busy.
PORT=3000

# --- Optional: Manus OAuth (login). Leave empty to browse without auth. -----
# VITE_APP_ID=
# OAUTH_SERVER_URL=
# VITE_OAUTH_PORTAL_URL=
# OWNER_OPEN_ID=
# OWNER_NAME=

# --- Optional: Manus built-in Forge APIs (LLM, storage, notifications) ------
# BUILT_IN_FORGE_API_URL=
# BUILT_IN_FORGE_API_KEY=
# VITE_FRONTEND_FORGE_API_URL=
# VITE_FRONTEND_FORGE_API_KEY=
