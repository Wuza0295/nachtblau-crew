# Kopie nach ~/.config/nachtblau/autosync.env (Linux)
# bzw. %APPDATA%\nachtblau\autosync.env (Windows) — nicht committen.

# Repo-Pfad (leer = Skript ermittelt aus Install-Ort)
# NACHTBLAU_REPO=

# Git-Branch für Auto-Pull (leer = aktueller Branch)
# SYNC_BRANCH=
SYNC_REMOTE=origin

# Dual-Boot Sync-Root (Pflicht für Spielstände)
# Linux:  NACHTBLAU_SYNC_ROOT=/mnt/nachtblau-sync
# Windows: NACHTBLAU_SYNC_ROOT=D:\NachtBlauSync

# Bausteine (1=an, 0=aus)
AUTO_SYNC_GIT=1
AUTO_SYNC_SILK=1
AUTO_SYNC_SAVES=1
AUTO_SYNC_HUB_CHECK=1
# Hub-Upload nur mit FTP_USER/FTP_PASS — sonst wird übersprungen
AUTO_SYNC_HUB_DEPLOY=0
# Minecraft-Desktop-Neuinstallation: bewusst aus (schwer, braucht sudo/Admin)
AUTO_SYNC_DESKTOP=0

# pnpm install bei jedem Lauf (1) oder nur wenn lockfile neuer (0)
AUTO_SYNC_PNPM=1
