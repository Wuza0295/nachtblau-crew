[Unit]
Description=NachtBlau Minecraft Bedrock
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=mc
Group=mc
WorkingDirectory=/opt/minecraft-bedrock
EnvironmentFile=-/etc/nachtblau/minecraft.env
ExecStart=/opt/minecraft-bedrock/start-bedrock.sh
Restart=on-failure
RestartSec=15
TimeoutStopSec=60

[Install]
WantedBy=multi-user.target
